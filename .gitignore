# Ignore everything in these folders
backup/*
output/*
channels/*
on_demand/*
media/raw/*
media/converted/*
src/__pycache__/*
.vscode/
backup-channels.json

# Keep folder placeholders
!backup/.gitkeep
!media/.gitkeep
!media/converted/.gitkeep
!media/raw/.gitkeep
!output/.gitkeep
!channels/.gitkeep
!on_demand/.gitkeep

# Ignore saved local chat history and context notes
chat_history/

# Ignore macOS resource fork files
._*
