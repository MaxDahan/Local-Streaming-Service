# Runtime/generated folders (keep placeholders only)
backup/*
output/*
channels/*
on_demand/*

!backup/.gitkeep
!output/.gitkeep
!channels/.gitkeep
!on_demand/.gitkeep

# Local media library (never commit actual media)
media/raw/**
media/converted/**

!media/.gitkeep
!media/raw/.gitkeep
!media/converted/.gitkeep

# Chat/data history and local notes
output/chat_history/
output/users.json
output/folder_resume.json
chat_history/
backup-channels.json

# Python/cache/editor noise
__pycache__/
*.py[cod]
.vscode/

# OS artifacts
.DS_Store
._*
